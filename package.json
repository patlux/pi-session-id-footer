  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patlux/pi-session-id-footer.git"
  },
  "homepage": "https://github.com/patlux/pi-session-id-footer#readme",
  "bugs": {
    "url": "https://github.com/patlux/pi-session-id-footer/issues"
  },
  "publishConfig": {
